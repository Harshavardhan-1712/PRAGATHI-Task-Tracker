# ============================================================
# PRAGATHI - Environment Configuration
# ============================================================

APP_NAME="PRAGATHI"
APP_TAGLINE="Turn Intentions Into Accomplishments"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Kolkata"

# Database Configuration (XAMPP MySQL Standard)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pragathi_db
DB_USERNAME=root
DB_PASSWORD=

# Seamless fallback to SQLite if MySQL service is not running (great for testing)
DB_FALLBACK_SQLITE=true
SQLITE_PATH=storage/pragathi.sqlite

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
